{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h19.dev/schemas/test-candidate.v0.1.schema.json",
  "title": "H19 Executable Test Candidate v0.1",
  "type": "object",
  "required": [
    "schemaVersion",
    "specSha256",
    "renderer",
    "target",
    "content",
    "contentSha256",
    "candidateSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "specSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "renderer": {
      "type": "object",
      "required": [
        "rendererId",
        "version",
        "framework",
        "language",
        "artifactSha256"
      ],
      "properties": {
        "rendererId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "framework": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "artifactSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "path",
        "operation",
        "baseFileSha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": [
            "create",
            "replace"
          ]
        },
        "baseFileSha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "baseFileSha256": {
                "type": "string"
              }
            },
            "required": [
              "baseFileSha256"
            ]
          },
          "then": {
            "properties": {
              "baseFileSha256": {
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "contentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidateSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
