{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h19.dev/schemas/code-graph.v1.schema.json",
  "title": "H19 Code Graph v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "kind"
        ]
      }
    }
  },
  "additionalProperties": false
}
