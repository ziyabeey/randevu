{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h19.dev/schemas/evidence.v1.schema.json",
  "title": "H19 Evidence v1",
  "type": "object",
  "required": [
    "id",
    "state",
    "producer",
    "producerVersion",
    "provenanceDigest"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "present",
        "absent",
        "unknown"
      ]
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "producerVersion": {
      "type": "string",
      "minLength": 1
    },
    "inputDigest": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "details": {
      "type": "object"
    },
    "observedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenanceDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
