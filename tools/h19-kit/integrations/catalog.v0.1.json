{
  "version": "H19-INTEGRATION-CATALOG-0.1",
  "policy": "No third-party source is bundled unless an exact-version license review explicitly allows it.",
  "integrations": [
    {
      "id": "typescript6-parser",
      "project": "@typescript/typescript6",
      "version": "6.0.2",
      "license": "Apache-2.0",
      "mode": "direct-toolkit-dependency",
      "use": [
        "TypeScript/JavaScript AST semantic-unit extraction"
      ],
      "notes": [
        "Installed only in tools/h19-kit; do not replace the host application's TypeScript 7 compiler."
      ]
    },
    {
      "id": "tornhill-patterns",
      "project": "Tornhill",
      "license": "MIT OR Apache-2.0",
      "mode": "clean-room-pattern",
      "use": [
        "versioned rule cards",
        "evidence scoping"
      ]
    },
    {
      "id": "testmon-adapter",
      "project": "pytest-testmon",
      "license": "MIT",
      "mode": "adapter-first",
      "use": [
        "test impact memory"
      ]
    },
    {
      "id": "semgrep-cli",
      "project": "Semgrep engine",
      "license": "LGPL-2.1",
      "mode": "external-process",
      "use": [
        "AST/static facts"
      ],
      "notes": [
        "Do not bundle Semgrep community rules under their separate rules license."
      ]
    },
    {
      "id": "stryker-patterns",
      "project": "StrykerJS",
      "license": "Apache-2.0",
      "mode": "clean-room-pattern",
      "use": [
        "mutation registry",
        "incremental mutation history"
      ]
    },
    {
      "id": "pr-agent-patterns",
      "project": "PR-Agent",
      "license": "MIT",
      "mode": "clean-room-pattern",
      "use": [
        "token-aware diff context packing"
      ]
    },
    {
      "id": "code-maat-patterns",
      "project": "Code Maat",
      "license": "GPL-3.0",
      "mode": "clean-room-reimplementation",
      "use": [
        "temporal coupling",
        "churn/hotspot ideas"
      ],
      "notes": [
        "Do not link or vendor GPL implementation into proprietary core without a separate legal decision."
      ]
    },
    {
      "id": "ctxwitch-patterns",
      "project": "ctxwitch",
      "license": "Apache-2.0",
      "mode": "clean-room-pattern",
      "use": [
        "behavioral dimensions",
        "unresolved state"
      ]
    },
    {
      "id": "reviewdog-output",
      "project": "reviewdog",
      "license": "MIT",
      "mode": "standard-output",
      "use": [
        "SARIF/RDJSON-compatible reporting"
      ]
    },
    {
      "id": "tree-sitter-tags",
      "project": "Tree-sitter",
      "license": "MIT",
      "mode": "external-process",
      "use": [
        "syntax-only fallback symbol tags"
      ],
      "notes": [
        "Fallback only; compiler-backed/native/SCIP relationships have higher authority."
      ]
    },
    {
      "id": "scip-cli",
      "project": "SCIP",
      "license": "Apache-2.0",
      "mode": "external-process",
      "use": [
        "symbol definitions",
        "references",
        "relationships",
        "cross-file impact"
      ]
    },
    {
      "id": "nx-affected",
      "project": "Nx",
      "license": "MIT",
      "mode": "external-process",
      "use": [
        "affected project graph evidence"
      ]
    },
    {
      "id": "turborepo-affected",
      "project": "Turborepo",
      "license": "MIT",
      "mode": "external-process",
      "use": [
        "affected package/task evidence"
      ]
    },
    {
      "id": "scip-typescript-indexer",
      "project": "@sourcegraph/scip-typescript",
      "license": "Apache-2.0",
      "mode": "external-process",
      "use": [
        "TypeScript/JavaScript SCIP index generation"
      ],
      "notes": [
        "Never auto-install. H19 Kit only invokes an already-installed scip-typescript binary."
      ]
    }
  ]
}
