  "question": {
    "id": "RELATION_DIRECTION",
    "version": "0.1",
    "type": "choice",
    "instructions": "Given one frozen hypothesis, 2–4 normalized facts and deterministic features, decide how considering the facts together changes support for the frozen hypothesis compared with considering the supplied facts independently. Do not infer missing facts. Do not calculate new metrics. Do not treat shared-lineage facts as independent confirmation.",
    "criteria": {
      "strengthens": "The supplied combination adds mutually reinforcing support beyond the facts considered independently.",
      "weakens": "The combination introduces a contradiction or materially undercuts support.",
      "unrelated": "The relationship does not materially change support for the hypothesis.",
      "insufficient": "Unknowns, incompatible metrics, lineage ambiguity or missing evidence prevent a justified relation judgment."
    }
  },
  "assessorContract": {
    "requiredIndependentAssessmentsPerCase": 2,
    "labels": [
      "strengthens",
      "weakens",
      "unrelated",
      "insufficient"
    ],
    "assessOnePacketAtATime": true,
    "allowedEvidence": [
      "packet.relationalCase",
      "freeze.question"
    ],
    "forbiddenExposure": [
      "Jev/provider judgments or probabilities for the case",
      "later functional outcomes or validation results for the case",
      "other assessor labels or rationales before sealing own receipt",
      "evaluation-split observations"
    ],
    "disagreementPolicy": "retain both sealed receipts; adjudicate separately without rewriting either receipt",
    "unresolvedPolicy": "unresolved is an adjudication state, not a fifth relation label"
  },
  "receiptContract": {
    "schemaVersion": 1,
    "requiredFields": [
      "packetId",
      "caseSha256",
      "assessorId",
      "assessorKind",
      "rubricId",
      "rubricVersion",
      "label",
      "rationale",
      "exposure",
      "sealedAt"
    ],
    "exposure": {
      "jevOutputSeen": false,
      "laterFunctionalOutcomeSeen": false,
      "peerAssessmentSeen": false,
      "evaluationObservationSeen": false
    },
    "rationaleRule": "brief case-bound explanation using only supplied facts/features; do not infer missing evidence or compute new metrics"
  },
