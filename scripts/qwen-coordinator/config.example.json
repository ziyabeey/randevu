{
  "version": 3,
  "mode": "shadow",
  "projectName": "YZT Randevu",
  "repoRoot": "__REPO_ROOT__",
  "repoSlug": "ziyabeey/randevu",
  "defaultBranch": "main",
  "githubAuthenticatedPollSeconds": 60,
  "githubActivePollSeconds": 30,
  "githubLowRateLimitThreshold": 1000,
  "githubLowRateLimitPollSeconds": 300,
  "githubCriticalRateLimitThreshold": 250,
  "githubCriticalRateLimitPollSeconds": 900,
  "qwenRetrySeconds": 120,
  "qwenTimeoutSeconds": 60,
  "qwenPromptVersion": 3,
  "qwenEndpoint": "http://127.0.0.1:8080",
  "maxOpenPullRequests": 20,
  "maxTaskRows": 200,
  "coordinationIssueNumber": 65,
  "requiredCheckName": "CI gate",
  "depotShadowEnabled": false,
  "depotBinary": "__DEPOT_BINARY__",
  "depotOrgId": "__DEPOT_ORG_ID__",
  "depotWorkflowFile": "__COORDINATOR_HOME__/depot-full-ci.yml",
  "depotWorkflowName": "qwen-coordinator-full-ci-shadow-v1",
  "depotCommentSchemaVersion": 2,
  "depotJob": "verify",
  "depotMaxConcurrentRuns": 1,
  "depotStartTimeoutSeconds": 120,
  "depotMaximumStartAttempts": 2,
  "depotRetrySeconds": 120,
  "depotBackfillPullNumbers": [],
  "mergeMethod": "squash",
  "writeActionsEnabled": false,
  "autoReadyEnabled": false,
  "autoMergeEnabled": false,
  "coordinationCommitsEnabled": false,
  "maxActionsPerRun": 1,
  "maximumActionAttempts": 3,
  "actionRetrySeconds": 900,
  "allowedAutomaticActions": [
    "collect_local_state",
    "refresh_github_evidence",
    "run_exact_sha_depot_shadow_ci",
    "update_single_depot_evidence_comment",
    "write_disposable_report"
  ],
  "trustedReceiptActorsByRole": {
    "R1": [],
    "R2": []
  },
  "docsOnlyPatterns": [
    "docs/",
    "tasks.md",
    "project_state.md",
    "roadmap.md",
    "product_spec.md",
    "contributing.md",
    "agents.md",
    ".md"
  ],
  "r1PathPatterns": [
    "supabase/migrations/",
    "src/worker",
    "worker/",
    "auth",
    "rls",
    "billing",
    "payment",
    "ledger"
  ],
  "r2PathPatterns": [
    "scripts/browser-",
    "tests/browser/",
    "page.tsx",
    "src/main.tsx",
    "src/app.tsx",
    "src/marketing/"
  ]
}
