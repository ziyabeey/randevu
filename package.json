{
  "name": "yzt-randevu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "build:staging": "npm run typecheck && CLOUDFLARE_ENV=staging vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:http": "node --test --experimental-strip-types tests/*.test.mjs",
    "test:ci-coverage": "node scripts/verify-ci-coverage.mjs",
    "test:browser-smoke": "bash scripts/browser-smoke.sh",
    "staging:seed": "node scripts/staging-db.mjs seed",
    "staging:reset": "node scripts/staging-db.mjs reset",
    "staging:config": "node scripts/staging-db.mjs config",
    "staging:smoke": "node scripts/staging-smoke.mjs"
  },
  "dependencies": {
    "hono": "4.13.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wrangler": "4.131.0"
  }
}
